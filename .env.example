# Copy this file to .env and fill in the values. The steps are in README.md.

# Where the app runs. Must match the redirect URIs set in Meta and Google exactly.
PORT=3000
BASE_URL=http://localhost:3000

# The setup code that creates the first admin account. Required when BASE_URL isn't this machine,
# including behind a tunnel, so strangers can't claim that account. It does nothing after that.
APP_PASSWORD=

# Set to true to let anyone sign up without an invite code.
SIGNUP_OPEN=false

# How much video each person can keep on the server by default, in MB. Admin accounts have no limit,
# and an admin can set a different limit for one person on the Admin page.
USER_STORAGE_MB=10240

# Finished posts and their videos are removed from this server after this many days. Posts on the
# platforms are not touched. If you change it, update the privacy policy and terms in site/ to match.
POST_RETENTION_DAYS=7

# Facebook and Instagram
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=

# YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
